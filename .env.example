# Optional: pin the Emscripten image used by Docker Compose.
EMSDK_IMAGE=emscripten/emsdk:latest

# Optional: change the host port used by the development web server.
WEB_PORT=8000

# Optional: change the HTTPS port published by nginx.
HTTPS_PORT=443

# Optional on Linux/WSL: uncomment and set these to your real `id -u` / `id -g`
# if you want generated files to be owned by your user. By default Compose runs
# as root to avoid first-run bind-mount permission errors on fresh clones.
# HOST_UID=1000
# HOST_GID=1000

# --- Web application (W-01 scaffold) ---------------------------------------
# Backend (Fastify) listen port. The frontend dev server proxies /api here.
BACKEND_PORT=3000

# Frontend (Vite) dev server port.
FRONTEND_PORT=5173

# --- B-03 (Prisma/SQLite) ---------------------------------------------------
# SQLite の実ファイル。**相対パスの基準は app/backend/**（prisma.config.ts の位置）。
# 未設定なら prisma.config.ts と src/db/client.ts が同じ既定値を使うので、
# ローカル開発では省略できる。コンテナ（I-15）では明示的に渡すこと。
# DATABASE_URL="file:./data/dev.db"

# --- Added by later issues -------------------------------------------------
# B-04 (auth):          SESSION_SECRET=change-me-to-a-long-random-string
# B-05 (origin check):  ALLOWED_ORIGIN=https://localhost
#
# Temporary local-only auth stub for W-08〜W-11 development.
# Never enable this in production. `x-dev-user` is rejected unless this is true.
# NODE_ENV=development
# ALLOW_DEV_AUTH=true
#
# F-01 (frontend): 開発時に backend の /api/auth/me を叩かず、ダミー user で
# ログイン済み状態にする。W-04 未実装時に Layout/Guards の挙動を目視するための stub。
# **production ビルド（import.meta.env.DEV=false）では二重ガードで無効化される**
# ため、誤って本番 .env に立てても発動しないが、それでも本番には置かないこと。
# VITE_DEV_AUTOLOGIN=1
