# ビルド成果物
*.o
*.d
*.ok
codes/obj/
/cub3D
/codes/tests/sim_test

# 実行時生成物（スクリーンショット BMP の出力先）
bmp/
screenshot/**/*.bmp

# Claude Code のワークツリー/ローカルメタ（誤コミット厳禁）
.claude/

# Python バイトコードキャッシュ
__pycache__/
*.pyc
# Web/Emscripten generated outputs
/web/assets/
/web/build/

# F-06: `make frontend-engine-assets` の配布先（Vite/nginx が /engine/ で配信）
/app/frontend/public/engine/

# E-12 デモの記録（record.mjs が生成）
/web/sim_demo/snapshots.json
/web/sim_demo/snapshots_fps.json

# Local Docker/compose overrides
.env

# 作業中に手元で出力したログダンプ（git log > log 等）。誤コミット防止
/log

# Node / TypeScript（W-01 で追加した backend / frontend / shared）
node_modules/
dist/
*.tsbuildinfo
.vite/

# B-03 以降: SQLite の実データ（スキーマ・マイグレーションは追跡する）
# 旧 `backend/data/` はリポジトリ直下にアンカーされていて実際のパス
# `app/backend/data/` に効いていなかったため、B-03 で正しい位置へ直した。
app/backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# B-03: prisma generate の生成物（Prisma 7 は TypeScript ソースを吐く）。
# `npm run typecheck` / `build` が実行前に生成するので、追跡しない。
app/backend/src/generated/

# W-15: 自己署名証明書（初回 compose 起動時に生成）
infra/certs/

# エディタのローカル設定（md_files を Obsidian 等で開くと作られる）
.obsidian/
.idea/
.vscode/
