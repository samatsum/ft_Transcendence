events {}

http {
	# nginx がデフォルトで用意する MIME タイプと拡張子のマッピングファイルを含める
	include /etc/nginx/mime.types;

	# テキスト資産の動的 gzip。JS バンドルが 390KB あるので効く。
	# **`application/octet-stream` を入れないこと**——`.tex` がここに落ちるため、
	# 入れるとリクエストのたびに 221MB を圧縮する羽目になる。
	# `.tex` / `.wasm` は事前生成した `.gz` を gzip_static が返す（下の location）。
	gzip on;
	gzip_vary on;
	gzip_min_length 1024;
	gzip_types
		text/css
		text/plain
		application/javascript
		application/json
		image/svg+xml;

	# **このファイルはテンプレートで、entrypoint.sh が envsubst で
	# `${SERVER_NAME}` `${TLS_CERT}` `${TLS_KEY}` だけを置換して
	# /etc/nginx/nginx.conf を書き出す。** `$uri` や `$http_upgrade` のような
	# nginx 自身の変数は envsubst に渡す変数名を限定することで守られている。
	# 新しい `${...}` を書くときは entrypoint.sh の置換リストにも足すこと。

	# 平文 HTTP。VPS では Let's Encrypt の応答と https への誘導に使う。
	# ローカルの compose は 80 番を公開しないので、この server は使われない。
	server {
		listen 80;
		server_name ${SERVER_NAME};

		# certbot --webroot による発行・更新のための応答（VPS 用の
		# docker-compose.vps.yml が /var/www/certbot をマウントする）
		location /.well-known/acme-challenge/ {
			root /var/www/certbot;
		}

		# **`$host` ではなく `${SERVER_NAME}`。** 80 番は誰でも叩けて Host
		# ヘッダも自由に付けられるので、`$host` だと攻撃者の指定した宛先を
		# Location に載せてしまう（オープンリダイレクト）
		location / {
			return 301 https://${SERVER_NAME}$request_uri;
		}
	}

	server {
		# 443 で HTTPS を受け付ける
		listen 443 ssl;
		server_name ${SERVER_NAME};

		# 既定ではローカル CA の localhost 証明書（entrypoint.sh が初回起動時に生成）。
		# VPS では Let's Encrypt の証明書を環境変数で指す
		ssl_certificate ${TLS_CERT};
		ssl_certificate_key ${TLS_KEY};
		ssl_protocols TLSv1.2 TLSv1.3;

		# frontend サービスが生成する Vite の dist を公開する（docker-compose.yml 参照）
		root /usr/share/nginx/html;
		# ディレクトリへのアクセス時にデフォルトで index.html を返す
		index index.html;

		# ブラウザに Content-Type を勝手に解釈させない
		add_header X-Content-Type-Options nosniff always;

		# /api/ 以下はパスを変えずに Fastify へ転送する
		location /api/ {
			proxy_pass http://backend:3000;
		}

		# /ws/ 以下は WebSocket として Fastify へ転送する
		# Cookie と Origin は nginx のデフォルト動作でそのまま転送される
		location /ws/ {
			proxy_pass http://backend:3000;
			proxy_http_version 1.1;					# バックエンドとの WebSocket 通信に必要な HTTP/1.1を指定
			proxy_set_header Upgrade $http_upgrade;	# Upgrade ヘッダーをバックエンドへ転送する
			proxy_set_header Connection "upgrade";	# バックエンドへ接続方式をアップグレードすることを要求
		}

		# エンジン資産の配信
		#
		# **正規表現 location はプレフィックス location より先に評価され、
		# 記述順で最初に一致したものが勝つ。** 下の3つは順序に依存しないよう
		# 拡張子で排他にしてあるが、`location /engine/` を足しても `.wasm` /
		# `.tex` には効かない点に注意すること。
		#
		# また **`add_header` はその階層に1つでもあると上位の add_header を
		# 一切継承しない。** server ブロックの nosniff が消えるので、
		# add_header を書く location では明示的に書き直している。
		#
		# キャッシュは3つとも **`no-cache`（毎回 ETag で再検証し、変化が
		# 無ければ 304）** に揃える。期限付き（max-age）にしないのは、
		# ファイル名にハッシュが無くリビルドで同じ URL の中身が変わるため。
		# 片方だけ期限付きにすると、新しい render.js と古い render.wasm、
		# 新しい manifest.json と古い .tex の組み合わせをブラウザが作る。

		# WebAssembly を正しい Content-Type で返す
		# ファイルが無い場合は SPA へ戻さず 404 にする
		location ~* \.wasm$ {
			try_files $uri =404;
			default_type application/wasm;
			gzip_static on;
			gzip_vary on;
			add_header X-Content-Type-Options nosniff always;
			add_header Cache-Control "no-cache" always;
		}

		# テクスチャは無圧縮 RGBA で合計 221MB ある。素で配ると遠隔からは
		# 実用にならない（docs/ai/backlog.md の I-15 に計測あり）。
		#
		# **`gzip` ではなく `gzip_static`。** 前者はリクエストのたびに 221MB を
		# 圧縮し直すことになる。`.tex.gz` は xpm_to_tex.py がビルド時に作るので、
		# ここはそれを返すだけ。実測 221.2MB → 8.6MB（3.9%）。
		#
		# **`default_type` を消さないこと。** このファイルは nginx 同梱の
		# nginx.conf を丸ごと置き換えており、mime.types に `.tex` も無いので、
		# 指定しないと組み込み既定の `text/plain` になる。`text/plain` は上の
		# gzip_types に入っているため、`.tex.gz` が欠けたときに動的 gzip へ
		# 落ちて、リクエストのたびに最大 16MB を圧縮し直す。
		location ~* \.tex$ {
			try_files $uri =404;
			default_type application/octet-stream;
			gzip_static on;
			gzip_vary on;
			add_header X-Content-Type-Options nosniff always;
			add_header Cache-Control "no-cache" always;
		}

		# manifest.json や render.js など、上2つ以外のエンジン資産
		location /engine/ {
			try_files $uri =404;
			add_header X-Content-Type-Options nosniff always;
			add_header Cache-Control "no-cache" always;
		}

		# 実ファイルが無い URL は React Router に処理させる
		location / {
			try_files $uri $uri/ /index.html;
		}
	}
}
